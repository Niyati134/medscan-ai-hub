# Copy this file to ".env" and fill in your own values. ".env" is git-ignored - never commit it.
# Restart `npm run dev` after changing anything here.

# ---- Supabase: browser-safe values (exposed to the client bundle) -----------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# ---- Supabase: server-side copies of the same two values ---------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# ---- SECRET, server only (never prefix with VITE_) --------------------------------
# Needed for: the shared price cache, public share links, and the admin console.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ---- Optional Gemini tuning --------------------------------------------------------
# Primary model (default: gemini-3.8-flash). gemini-3.5-flash-lite is faster/cheaper.
# GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the primary model is overloaded (503), rate limited (429),
# times out, or is not found. Set to "off" to disable (default: gemini-3.6-flash).
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Max simultaneous Gemini requests per server process (default 3) - protects free-tier quota.
# GEMINI_MAX_CONCURRENCY=3

# ---- Optional: nearby pharmacy/hospital locator (Lovable Google Maps connector) ----
# Without these the locator shows its built-in "not configured" fallback.
# LOVABLE_API_KEY=
# GOOGLE_MAPS_API_KEY=
# VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
